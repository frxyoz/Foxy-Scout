{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foxy Scout",
  "version": "2.0.0",
  "identifier": "local.foxy.scout",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [{ "title": "Foxy Scout · FM24", "width": 1440, "height": 960, "minWidth": 920, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {"active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/icon.png"], "macOS": {"minimumSystemVersion": "10.15"}}
}
